{
  "name": "AI Agents Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days"
            }
          ]
        }
      },
      "name": "Scheduler Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "functionCode": "return { json: { status: 'mock parsed resume' } };"
      },
      "name": "ResumeParsingAgent",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [200, 0]
    },
    {
      "parameters": {
        "functionCode": "return { json: { \"jobs\": [ { \"company\": \"ABC Corp\", \"role\": \"Developer\" } ] } };"
      },
      "name": "JobDiscoveryAgent",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [400, 0]
    },
    {
      "parameters": {
        "functionCode": "return { json: { status: 'mock ranked jobs' } };"
      },
      "name": "JobRankingAgent",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [600, 0]
    },
    {
      "parameters": {
        "functionCode": "return { json: { status: 'mock outreach email sent' } };"
      },
      "name": "OutreachEmailAgent",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [800, 0]
    },
    {
      "parameters": {
        "functionCode": "return { json: { status: 'mock chatbot refinement' } };"
      },
      "name": "ChatbotRefinementAgent",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "functionCode": "return { json: { status: 'mock evaluation logged' } };"
      },
      "name": "Logging/EvaluationAgent",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1200, 0]
    }
  ],
  "connections": {
    "Scheduler Trigger": {
      "main": [
        [
          {
            "node": "ResumeParsingAgent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ResumeParsingAgent": {
      "main": [
        [
          {
            "node": "JobDiscoveryAgent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "JobDiscoveryAgent": {
      "main": [
        [
          {
            "node": "JobRankingAgent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "JobRankingAgent": {
      "main": [
        [
          {
            "node": "OutreachEmailAgent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OutreachEmailAgent": {
      "main": [
        [
          {
            "node": "ChatbotRefinementAgent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ChatbotRefinementAgent": {
      "main": [
        [
          {
            "node": "Logging/EvaluationAgent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
